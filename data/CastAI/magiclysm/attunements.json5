{
    require_mod: "Magiclysm",
    table: {
        // === WITHER_MAGE 凋零法师 ===
        // 刺杀术 - 你猛烈一击，然后消失在一股有毒的烟雾中。
        assassin_strike: null,
        // 生命汲取 - 这个法术会夺去目标的一部分生命；其中一部分以一种不那么有效的形式输送给你。
        life_drain: null,

        // === VULCANIST 火山术士 ===
        // 熔岩炸弹 - 你撕裂脚下的地面，发射出一个熔岩炸弹：一个被炽热的固体岩石包围的熔岩球。它撞击物体时会粉碎，朝四周射出大量碎岩石和熔岩。
        lava_bomb_main: null,
        // 火山碎屑流 - 引发地球内部蕴含的火焰，还有大量的烟雾和灰烬。
        vulcanist_pyroclastic_flow: null,

        // === VOID_MAGE 虚空法师 ===
        // 终结之握 - 万物终将归于虚无与停滞，此术能令目标预尝其味。
        voidmage_final_grasp: null,
        // 视界漩涡 - 召唤一处充满混沌魔法的力场，扰乱其中的敌人。效果相当随机，法术影响可能从几乎没有到杀死该地区内的所有敌人。
        voidmage_horizon_vortex: null,

        // === TUNDRA_MAGE 冻土法师 ===
        // 寒潮 - 只需一个响指，目标就会被冻结在原地并受到寒冷伤害。
        cold_snap: null,
        // 召唤冬狼 - 召唤你直属的冬狼群来冻结并撕碎你的敌人。
        summon_winter_wolf: null,

        // === SUN_MAGE 太阳法师 ===
        // 日光束 - 发射一束阳光，使其路径上的所有生物都失明，并在几秒钟内保持明亮状态。
        solar_beam: null,
        // 口袋太阳 - 你在客观现实的构架上创造出一个通往太阳的稳定传送门，通过它你可以利用太阳的光照和温度。
        sunmage_pocket_sun: null,

        // === STORM_ELEMENTAL 风暴元素 ===
        // 闪电风暴链 - 除了目标遭到重创外，闪电还会跳到附近的多个敌人身上。
        storm_chain_master: null,
        // 放电 - 让你的双手充满高压电，并在近战中造成额外的电击伤害。
        storm_elemental_electric_melee: null,

        // === STORMCALLER 唤雷者 ===
        // 闪电恶魔 - 召唤一个闪电小恶魔——快如闪电，也同样致命。
        electric_demon: null,
        // 闪电柱 - 召唤出一道不可移动的柱子，用毁灭性的闪电攻击你的敌人。
        electric_turret: null,

        // === SOULFIRE 魂火 ===
        // 两头烧 - 一根蜡烛在两头烧时最明亮，但燃烧速度却是原来的两倍。
        burn_at_both_ends: null,
        // 灵魂助推 - 你燃烧一小部分灵魂，以换取速度的巨大爆发。在你的灵魂痊愈之前，你将无法再次燃烧它。
        soul_afterburner: null,
        soul_afterburner_real: null,

        // === SHAPESHIFTER 变形者 ===
        // 万能溶剂 - 喷射出一股魔力饱和的生物活性溶剂。因为你的魔力特征，你体内的灵脉能让你抵御这种酸蚀，但旁人可得当心！
        shapeshifter_alkahest: null,
        // 生物力学 - 谁说人之肉身羸弱不堪？你只需将足够的魔力压缩到血肉筋骨之中，便能让他们瞧瞧，谁才是这世上最致命的猛兽。
        biomechanic: null,

        // === SHAMAN 萨满 ===
        // 蝶群 - 召唤出一群长着锋利翅膀的蝴蝶，能把挡路的每个生物都切得粉碎。
        butterfly_swarm: null,
        // 林海卫士 - 召唤一位林间守护者，一个强大的远古森林之灵，来为你而战。守护者可以骑乘，它会对非自然的敌人宣泄怒火，但在城市中远不如在森林里强大。
        summon_keeper_of_the_glades: null,
        summon_keeper_of_the_glades_pet_effect: null,

        // === RADIATION_MAGE 辐射法师 ===
        // 短波术 - 烤熟附近的怪物（还包括你自己）。
        shortwave: null,
        // 伽马射线 - 在大范围内造成细胞损伤，施放速度快，但见效慢。
        gamma_burst: null,

        // === PERMAFROST_MAGE 永冻法师 ===
        // 冰雾术 - 使用你的魔力，你开始加速冰雾中的冰粒子，侵蚀被它包裹的一切物体。
        cold_energy: null,
        // 冰期 - 冻结范围内的所有生物，直至它们血肉开裂、骨骼碎裂、甲胄碎断。
        permafrost_mage_ice_age: null,

        // === OVERCLOCKER 超频者 ===
        // 超限加速术 - 此法术会使目标的新陈代谢急剧提升至危险水平，导致其身体自内崩解。
        overaccelerate: null,
        // 时间过载 - 魔法能量流入你体内，以自我毁灭的方式将你的速度提升到超自然的水平。你在敌人眼中是一个模糊不清的人影，用看不见的速度击倒他们。
        overclocker_drive: null,

        // === MAGNETISM_MAGE 磁力法师 ===
        // 磁轨炮 - 将子弹磁化后通过一个反向磁场将子弹以超声速发射，并留下一道闪光的尾迹。
        railgun: null,
        // 电子激光 - 通过使用高功率激光束电离空气分子，创建出一条从施法者手到目标的导电通道，然后沿着通道释放出50万伏的强大电荷。
        magnetismmage_electrolaser: null,
        // 电涌术 - 发出一道高频交变脉冲波。它无法伤害生物，但在眩晕和摧毁机器人方面效果卓越，尽管它并非电磁脉冲。
        robot_disabler_explosion: null,

        // === ILLUSIONIST 幻术师 ===
        // 光之矛 - 从你的指尖射出定向光，其亮度之高可以在一瞬间穿透目标的皮肤。
        spear_of_light: null,
        // 战场全息投影 - 扰乱你的敌人，它们看起来和你一模一样，并且像一个真人一样行动。
        illusionist_hologram: null,
        // 假影换位 - 愚弄现实，和你视线内的任何其他生物交换你的位置。
        illusionist_transposition: null,

        // === ICE_ELEMENTAL 冰元素 ===
        // 冰爪 - 你的手指凝结出坚硬的冰爪，让你的徒手攻击造成寒冷伤害并保护你的双手。
        summon_subzero_talons: null,
        // 冰寒之心 - 骤然降低敌人体内的温度，使其血液流动减缓，甚至震碎其脏器。
        cold_heart: null,
        // 恒霜术 - 凭借自己血液中的冰寒和魔法的力量，你召唤出一大块永不融化的魔法坚冰。
        iceelemental_frostcrystal: null,

        // === GRAVITY_MAGE 重力法师 ===
        // 引力子极化 - 改变并增幅你所选定的一点所受的引力，甚至能穿透墙壁。此法术会吸入物品，并对其中心造成钝击伤害。
        gravitymage_graviton: null,
        // 重力飞跃 - 将你的体重降至最低，并驾驭一股魔力流从远处跃向敌人。
        gravity_mage_leap: null,
        // 触知传动 - 当你接触一个物体时，操控它的引力会变得轻而易举。掌控你周身的引力来改变自身惯性，从而发动迅捷而沉猛的攻击。
        gravity_mage_melee: null,

        // === GOLEMANCER 魔像师 ===
        // 召唤黏土傀儡 - 以一个傀儡核心作为核心，将黏土塑造成一个人形傀儡，并使其运作一段时间。
        summon_golem_clay: null,
        summon_golem_focus: null,
        // 魔像推动 - 你通过魔像的力量将敌人推开。
        golem_push: null,

        // === GLACIER_MAGE 冰川法师 ===
        // 寒冰之钥 - 驭使源于冰川的万夫莫当之力造成严重的破坏。
        ice_clave: null,
        ice_clave_blunt: null,
        // 凛冽狂风 - 一阵比大地上任何山顶的都冷的风，从你指间盘旋而出，破坏、推动着途径的一切。
        frozen_winds: null,
        frozen_winds_push: null,

        // === GAIAS_CHOSEN 盖亚选民 ===
        // 轮回术 - 你将自身灵脉与世界相连，焕活血肉，宛若新生。
        gaiaschosen_samsara: null,
        // 尘土重生 - 以自身魂体为模，于地脉深处铸就一具拟身。当时机来临，你的肉身濒临毁灭之际，便可弃之而去，将意识迁入拟身之中。然此不朽之术，代价亦是沉重，你需以暂时的肉体衰弱作为交换。
        dust_reborn: null,
        // 大地铠甲 - 将你包裹在源于大地的致密而不可见的能量之中。等级越高，防御力越强。
        terra_armor: null,

        // === FORCE_MAGE 力场法师 ===
        // 力场刃 - 你直线射出一把力场凝聚而成的利刃，切割途经路径上的所有物品。
        force_blade: null,
        // 力场护盾 - 你召唤出一个由纯粹力场凝聚而成的护盾，能够保护你自身和身上装备不受伤害。
        force_magical_armor: null,

        // === FIRE_ELEMENTAL 火元素 ===
        // 骤燃术 - 你用双手引导魔法热能，严重烧伤你所接触的目标。
        flareup: null,
        // 火焰鞭 - 你召唤出一根由固态魔法火焰制成的鞭子。
        flarewhip: null,

        // === EARTH_ELEMENTAL 土元素 ===
        // 地震术 - 造成局部地震并会击倒敌人。
        quake: null,
        // 巨石冲击 - 向敌人发射三块巨石，造成钝器伤害并击退敌人。
        rock_blast: null,

        // === CRUSADER 圣战法师 ===
        // 圣盾术 - 圣战法师能在他们的手臂上召唤出一个经过魔法强化的盾，在武装近战时保护他们。
        holy_shield: null,
        // 审判之剑 - 这把光刃将切开它所接触到的任何邪恶！你可以将其变形为匕首、巨剑、长矛或锤矛。
        judgement_sword: null,

        // === CLEANSING_FLAME 净化之焰 ===
        // 烈焰足迹 - 吟诵短咒，将你的足迹化为灼灼火坑，在身后留下一道烈焰轨迹。每一步都会消耗魔力，但在法术生效期间，你将免疫火焰。
        burning_trail: null,
        // 焚祭 - 原初元素热能掀起的净化大爆炸将地表抹得干干净净，将地球炙烤回她最开始的模样：灼热岩石堆积成的不毛之球。
        immolate: null,
        cleansingflame_hermes_heal: null,
        cleansingflame_hermes_burn: null,

        // === BOREAL_MAGE 极光法师 ===
        // 极光浪潮 - 一道闪亮能量组成的涟漪自你手中荡漾开，化为磁力与寒风交织的壮丽洪流。
        auroral_wave: null,
        // 极光防护 - 创造一个坚固的外壳包裹住你的身体，为你提供坚实的防御。
        borealmage_auroral_guard: null,

        // === BLOOD_MAGE 血法师 ===
        // 高等放逐术 - 放逐术的更高级版本，它是一种试图驱逐怪物的仪式法术。由于与血魔法联系紧密，所以血法师更擅长使用这样的法术。
        banishment_greater: null,
        // 恶魔附身 - 你让恶魔短时间占有你的身体，赋予你强大的战斗能力。你仍然保持控制，不过你会暂时失去施法能力。
        demonic_possession: null,
        demonic_possession_real: null,

        // === BIOTEK 生化科技 ===
        // 氮气加速 - 你将自身肉体和生化插件超频，充能速度如此之快，以至于摩擦都能点燃四周的空气，给对方来一记碎骨拳。
        nitro_boost: null,
        // 紧急损管 - 治疗一点点目标所受的伤害。
        biotek_healing: null,

        // === ARTIFICER 机关术师 ===
        // 侦察蜂 - 派出一只部分魔法、部分电子、外形像黄蜂的侦察无人机，揭示你正前方一条线上的地形。侦察蜂可以穿过墙壁。
        spy_wasp: null,
        // 机关术师工具箱 - 机关术师们能通向一个特殊的口袋维度，其中有把魔法工具，可以完成各种各样的工作。你可以暂时召唤出这个工具供你使用一段时间。
        artificer_toolkit: null,

        // === ALCHEMIST 炼金术士 ===
        // 注能水 - 将空气中的乙醇和你自己的魔力注入水中，制造一些基础药剂。有时可能会反应过饱和，导致魔力溢出。
        alchemist_make_potion_starter: null,
        // 魔能聚变炸弹 - 使基础药剂的魔力过饱和，造成致命的魔能爆炸。
        alchemist_make_potion_bomb: null,
        // 魔能聚变陷阱 - 制造一个魔能聚变陷阱，稳定魔能聚变炸弹并返还多余魔力。
        alchemist_make_potion_trap: null,
    }
}
