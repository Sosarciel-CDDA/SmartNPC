        // 分析: effect=spawn_item + effect_str=aura_cold_energy + valid_targets=self + CHANNELING_SPELL → 特殊: 生成物品法术，暂不处理
        cold_energy: null,
        // 冰期 - 冻结范围内的所有生物，直至它们血肉开裂、骨骼碎裂、甲胄碎断。
        // 分析: effect=attack + effect_str=cold + 正数伤害(动态) + DOT(0-8) + valid_targets=hostile,ground + 有aoe(3-9) + 有range(5-40) → TargetDamage (AOE攻击)
        permafrost_mage_ice_age: null,

        // === OVERCLOCKER 超频者 ===
