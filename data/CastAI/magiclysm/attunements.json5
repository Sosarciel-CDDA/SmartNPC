        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile,ground,ally + range=5-15 + shape=line → TargetDamage (线形攻击)
        force_blade: null,
        // 力场护盾 - 你召唤出一个由纯粹力场凝聚而成的护盾，能够保护你自身和身上装备不受伤害。
        // 分析: effect=spawn_item + effect_str=force_magical_armor + valid_targets=none + CONJURATION_SPELL + duration=1h-4h → 特殊: 生成装备法术，暂不处理
        force_magical_armor: null,

        // === FIRE_ELEMENTAL 火元素 ===
        // 骤燃术 - 你用双手引导魔法热能，严重烧伤你所接触的目标。
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile + range=1 → TargetDamage (近战)
        flareup: null,
        // 火焰鞭 - 你召唤出一根由固态魔法火焰制成的鞭子。
        // 分析: effect=spawn_item + effect_str=flarewhip + valid_targets=none + CONJURATION_SPELL + duration=15min-50min → 特殊: 生成武器法术，暂不处理
        flarewhip: null,

        // === EARTH_ELEMENTAL 土元素 ===
        // 地震术 - 造成局部地震并会击倒敌人。
        // 分析: effect=attack + effect_str=downed + 正数伤害(动态) + valid_targets=hostile,ground + aoe=0-35 + 有bash_scaling → TargetDebuff (击倒效果+伤害)
        quake: null,
        // 巨石冲击 - 向敌人发射三块巨石，造成钝器伤害并击退敌人。
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile + range=8-15 + energy_source=STAMINA → TargetDamage
        rock_blast: null,

        // === CRUSADER 圣战法师 ===
        // 圣盾术 - 圣战法师能在他们的手臂上召唤出一个经过魔法强化的盾，在武装近战时保护他们。
        // 分析: effect=spawn_item + effect_str=holy_shield + valid_targets=none + CONJURATION_SPELL + duration=1h-10h → 特殊: 生成装备法术，暂不处理
        holy_shield: null,
        // 审判之剑 - 这把光刃将切开它所接触到的任何邪恶！你可以将其变形为匕首、巨剑、长矛或锤矛。
        // 分析: effect=spawn_item + effect_str=longsword_judgement + valid_targets=self + CONJURATION_SPELL + duration=1h-36h → 特殊: 生成武器法术，暂不处理
        judgement_sword: null,

        // === CLEANSING_FLAME 净化之焰 ===
        // 烈焰足迹 - 吟诵短咒，将你的足迹化为灼灼火坑，在身后留下一道烈焰轨迹。每一步都会消耗魔力，但在法术生效期间，你将免疫火焰。
        // 分析: effect=effect_on_condition + effect_str=EOC_CLEANSING_FLAME_FIRE_FOOSTEPS + valid_targets=self → 特殊: effect_on_condition暂不处理
        burning_trail: null,
        // 焚祭 - 原初元素热能掀起的净化大爆炸将地表抹得干干净净，将地球炙烤回她最开始的模样：灼热岩石堆积成的不毛之球。
        // 分析: effect=attack + 无effect_str + 正数伤害(61-79+) + valid_targets=ally,hostile,ground + range=4-8 + aoe=3-5 → TargetDamage (AOE攻击)
        immolate: null,
        // 赫尔墨斯复生 - 在无背风处的海中站立着赫耳墨斯之鸟吃着自己多变的翅膀使自己变得完全稳定（注：《黎普列卷轴》）
        // 分析: effect=attack + 负数伤害(-8到-15,即治疗) + valid_targets=self + RESTORATION_SPELL → SelfHeal
        cleansingflame_hermes_heal: null,
        // 分析: effect=attack + 正数伤害(8-20) + valid_targets=self + 有aoe(3-5) + 内部法术(子法术) → 特殊: 内部法术，暂不处理
        cleansingflame_hermes_burn: null,

        // === BOREAL_MAGE 极光法师 ===
        // 极光浪潮 - 一道闪亮能量组成的涟漪自你手中荡漾开，化为磁力与寒风交织的壮丽洪流。
        // 分析: effect=attack + 无effect_str + 正数伤害(25-45+) + valid_targets=hostile,ground + shape=cone + range=3-7 + aoe=22-60 → TargetDamage (锥形AOE)
        auroral_wave: null,
        // 极光防护 - 创造一个坚固的外壳包裹住你的身体，为你提供坚实的防御。
        // 分析: effect=spawn_item + effect_str=aura_auroral_guard + valid_targets=self + CONJURATION_SPELL + duration=16min-5.5h → 特殊: 生成物品法术，暂不处理
        borealmage_auroral_guard: null,

        // === BLOOD_MAGE 血法师 ===
        // 高等放逐术 - 放逐术的更高级版本，它是一种试图驱逐怪物的仪式法术。由于与血魔法联系紧密，所以血法师更擅长使用这样的法术。
        // 分析: effect=banishment + 正数伤害(120-640) + valid_targets=hostile + range=6 + aoe=0-2 + CONVEYANCE_SPELL → 特殊: 放逐法术，暂不处理
        banishment_greater: null,
        // 恶魔附身 - 你让恶魔短时间占有你的身体，赋予你强大的战斗能力。你仍然保持控制，不过你会暂时失去施法能力。
        // 分析: effect=effect_on_condition + effect_str=EOC_DEMON_POSSESSION + valid_targets=self + duration=1h-4h → 特殊: effect_on_condition暂不处理
        demonic_possession: null,
        // 分析: effect=spawn_item + effect_str=demon_possession_aura + valid_targets=self + 内部法术 → 特殊: 内部法术，暂不处理
        demonic_possession_real: null,

        // === BIOTEK 生化科技 ===
        // 氮气加速 - 你将自身肉体和生化插件超频，充能速度如此之快，以至于摩擦都能点燃四周的空气，给对方来一记碎骨拳。
        // 分析: effect=dash + effect_str=downed + 正数伤害(0-10+) + valid_targets=hostile,ground + range=8 + shape=cone + field_id=fd_fire → 特殊: 冲刺法术，暂不处理
        nitro_boost: null,
        // 紧急损管 - 治疗一点点目标所受的伤害。
        // 分析: effect=attack + 负数伤害(-2到-5,即治疗) + valid_targets=self + RESTORATION_SPELL → SelfHeal
        biotek_healing: null,

        // === ARTIFICER 机关术师 ===
        // 侦察蜂 - 派出一只部分魔法、部分电子、外形像黄蜂的侦察无人机，揭示你正前方一条线上的地形。侦察蜂可以穿过墙壁。
        // 分析: effect=attack + 无伤害 + valid_targets=hostile,ground + shape=line + field_id=fd_clairvoyant + CHANNELING_SPELL → 特殊: 侦察法术，暂不处理
        spy_wasp: null,
        // 机关术师工具箱 - 机关术师们能通向一个特殊的口袋维度，其中有把魔法工具，可以完成各种各样的工作。你可以暂时召唤出这个工具供你使用一段时间。
        // 分析: effect=spawn_item + effect_str=artificer_toolkit + valid_targets=none + CONJURATION_SPELL + duration=28min-16.8h → 特殊: 生成工具法术，暂不处理
        artificer_toolkit: null,

        // === ALCHEMIST 炼金术士 ===
        // 注能水 - 将空气中的乙醇和你自己的魔力注入水中，制造一些基础药剂。有时可能会反应过饱和，导致魔力溢出。
        // 分析: effect=spawn_item + effect_str=potion_starter + valid_targets=self + CONJURATION_SPELL → 特殊: 生成物品法术，暂不处理
        alchemist_make_potion_starter: null,
        // 魔能聚变炸弹 - 使基础药剂的魔力过饱和，造成致命的魔能爆炸。
        // 分析: effect=spawn_item + effect_str=alchemist_bomb + valid_targets=none + CONJURATION_SPELL + PERMANENT_ALL_LEVELS → 特殊: 生成物品法术，暂不处理
        alchemist_make_potion_bomb: null,
        // 魔能聚变陷阱 - 制造一个魔能聚变陷阱，稳定魔能聚变炸弹并返还多余魔力。
        // 分析: effect=spawn_item + effect_str=alchemist_mine + valid_targets=none + CONJURATION_SPELL + PERMANENT_ALL_LEVELS → 特殊: 生成物品法术，暂不处理
        alchemist_make_potion_trap: null,
    }
}
