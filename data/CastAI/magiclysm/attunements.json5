        // 分析: effect=summon + effect_str=mon_claygolem + valid_targets=ground + components=summon_golem → BattleSummonMonster
        summon_golem_clay: null,
        // 分析: effect=spawn_item + effect_str=golemcore + valid_targets=self + PERMANENT + 内部法术(返还傀儡核心) → 特殊: 内部辅助法术，暂不处理
        summon_golem_focus: null,
        // 魔像推动 - 你通过魔像的力量将敌人推开。
        // 分析: effect=directed_push + 无effect_str + 正数伤害(5-16) + valid_targets=hostile + range=1 + energy_source=HP → 特殊: 推动敌人法术，暂不处理
        golem_push: null,

        // === GLACIER_MAGE 冰川法师 ===
