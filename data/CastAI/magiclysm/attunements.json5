        gaiaschosen_samsara: null,
        // 尘土重生 - 以自身魂体为模，于地脉深处铸就一具拟身。当时机来临，你的肉身濒临毁灭之际，便可弃之而去，将意识迁入拟身之中。然此不朽之术，代价亦是沉重，你需以暂时的肉体衰弱作为交换。
        // 分析: effect=effect_on_condition + effect_str=EOC_DUST_REBORN_INITIAL + valid_targets=self + casting_time=6小时 → 特殊: effect_on_condition暂不处理
        dust_reborn: null,
        // 大地铠甲 - 将你包裹在源于大地的致密而不可见的能量之中。等级越高，防御力越强。
        // 分析: effect=attack + effect_str=effect_terra_armor + valid_targets=self + ENHANCEMENT_SPELL + duration=500s-5h → BattleSelfBuff (防御增益)
        terra_armor: null,

        // === FORCE_MAGE 力场法师 ===
