        // 分析: effect=attack + effect_str=neuro_boost + 正数伤害(5-20) + DOT(15-50) + valid_targets=hostile + ENHANCEMENT_SPELL → TargetDebuff (疑虑: 有伤害+DOT，可能是TargetDamage带额外效果)
        overaccelerate: null,
        // 时间过载 - 魔法能量流入你体内，以自我毁灭的方式将你的速度提升到超自然的水平。你在敌人眼中是一个模糊不清的人影，用看不见的速度击倒他们。
        // 分析: effect=attack + effect_str=overclocker_drive_effect + 伤害极低(1) + valid_targets=self + ENHANCEMENT_SPELL + duration=10s-25min → BattleSelfBuff (速度增益)
        overclocker_drive: null,

        // === MAGNETISM_MAGE 磁力法师 ===
