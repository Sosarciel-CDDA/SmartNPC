{
    require_mod: "Magiclysm",
    table: {
        // === WITHER_MAGE 凋零法师 ===
        // 刺杀术 - 你猛烈一击，然后消失在一股有毒的烟雾中。
        // 分析: effect=attack + 无effect_str + 正数伤害(14-21) + valid_targets=hostile → TargetDamage
        assassin_strike: null,
        // 生命汲取 - 这个法术会夺去目标的一部分生命；其中一部分以一种不那么有效的形式输送给你。
        // 分析: effect=attack + 无effect_str + 正数伤害(4-9) + valid_targets=hostile,ally + 有extra_effects恢复体力 → TargetDamage
        life_drain: null,

        // === VULCANIST 火山术士 ===
        // 熔岩炸弹 - 你撕裂脚下的地面，发射出一个熔岩炸弹：一个被炽热的固体岩石包围的熔岩球。它撞击物体时会粉碎，朝四周射出大量碎岩石和熔岩。
        // 分析: effect=attack + 无effect_str + 正数伤害(6-14) + valid_targets=hostile,ground,ally → TargetDamage
        lava_bomb_main: null,
        // 火山碎屑流 - 引发地球内部蕴含的火焰，还有大量的烟雾和灰烬。
        // 分析: effect=attack + 无effect_str + 正数伤害(21-34) + valid_targets=hostile,ground,ally + 有aoe(1-7) → TargetDamage (线形AOE攻击)
        vulcanist_pyroclastic_flow: null,

        // === VOID_MAGE 虚空法师 ===
        // 终结之握 - 万物终将归于虚无与停滞，此术能令目标预尝其味。
        // 分析: effect=attack + 无effect_str + 无直接伤害(0) + 有DOT(5-25) + valid_targets=hostile → TargetDamage (DOT伤害)
        voidmage_final_grasp: null,
        // 视界漩涡 - 召唤一处充满混沌魔法的力场，扰乱其中的敌人。效果相当随机，法术影响可能从几乎没有到杀死该地区内的所有敌人。
        // 分析: effect=attack + 无effect_str + 正数伤害(5-20) + valid_targets=hostile + 有extra_effects → TargetDamage
        voidmage_horizon_vortex: null,

        // === TUNDRA_MAGE 冻土法师 ===
        // 寒潮 - 只需一个响指，目标就会被冻结在原地并受到寒冷伤害。
        // 分析: effect=attack + 无effect_str + 正数伤害(14+) + valid_targets=hostile + 有extra_effects冻结 → TargetDamage (带冻结效果)
        cold_snap: null,
        // 召唤冬狼 - 召唤你直属的冬狼群来冻结并撕碎你的敌人。
        // 分析: effect=summon + effect_str=mon_winter_wolf + valid_targets=ground → BattleSummonMonster
        summon_winter_wolf: null,

        // === SUN_MAGE 太阳法师 ===
        // 日光束 - 发射一束阳光，使其路径上的所有生物都失明，并在几秒钟内保持明亮状态。
        // 分析: effect=attack + effect_str=blind(致盲) + 正数伤害(8-14) + valid_targets=hostile,ground → TargetDebuff (疑虑: 有伤害+致盲，可能是TargetDamage带额外效果)
        solar_beam: null,
        // 口袋太阳 - 你在客观现实的构架上创造出一个通往太阳的稳定传送门，通过它你可以利用太阳的光照和温度。
        // 分析: effect=spawn_item + effect_str=pocket_sun + valid_targets=self + duration极长 → 特殊: 生成物品法术，暂不处理
        sunmage_pocket_sun: null,

        // === STORM_ELEMENTAL 风暴元素 ===
        // 闪电风暴链 - 除了目标遭到重创外，闪电还会跳到附近的多个敌人身上。
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile + range=1(近战) → TargetDamage
        storm_chain_master: null,
        // 放电 - 让你的双手充满高压电，并在近战中造成额外的电击伤害。
        // 分析: effect=attack + effect_str=buff效果 + 无直接伤害(0) + valid_targets=self + duration=20s-12min + ENHANCEMENT_SPELL → AlawaySelfBuff (近战伤害加成)
        storm_elemental_electric_melee: null,

        // === STORMCALLER 唤雷者 ===
        // 闪电恶魔 - 召唤一个闪电小恶魔——快如闪电，也同样致命。
        // 分析: effect=summon + effect_str=mon_electric_demon + valid_targets=ground + CONJURATION_SPELL → BattleSummonMonster
        electric_demon: null,
        // 闪电柱 - 召唤出一道不可移动的柱子，用毁灭性的闪电攻击你的敌人。
        // 分析: effect=summon + effect_str=mon_electric_turret + valid_targets=ground + CONJURATION_SPELL → BattleSummonMonster
        electric_turret: null,

        // === SOULFIRE 魂火 ===
        // 两头烧 - 一根蜡烛在两头烧时最明亮，但燃烧速度却是原来的两倍。
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile + 有DOT(10) → TargetDamage
        burn_at_both_ends: null,
        // 灵魂助推 - 你燃烧一小部分灵魂，以换取速度的巨大爆发。在你的灵魂痊愈之前，你将无法再次燃烧它。
        // 分析: effect=effect_on_condition + effect_str=EOC_SOUL_AFTERBURNER + valid_targets=self + ENHANCEMENT_SPELL → 复杂: effect_on_condition暂不处理
        soul_afterburner: null,
        // 分析: effect=mod_moves + valid_targets=self + ENHANCEMENT_SPELL + 内部法术(由EOC触发) → 特殊: 内部增益法术，暂不处理
        soul_afterburner_real: null,

        // === SHAPESHIFTER 变形者 ===
        // 万能溶剂 - 喷射出一股魔力饱和的生物活性溶剂。因为你的魔力特征，你体内的灵脉能让你抵御这种酸蚀，但旁人可得当心！
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile,ground + shape=cone + 有field_id(fd_alkahest) → TargetDamage (锥形AOE)
        shapeshifter_alkahest: null,
        // 生物力学 - 谁说人之肉身羸弱不堪？你只需将足够的魔力压缩到血肉筋骨之中，便能让他们瞧瞧，谁才是这世上最致命的猛兽。
        // 分析: effect=attack + effect_str=biomechanic + 无直接伤害 + valid_targets=self + TRANSFORMATION_SPELL + duration=14s-330s → BattleSelfBuff (疑虑: 有effect_str，可能是变身效果)
        biomechanic: null,

        // === SHAMAN 萨满 ===
        // 蝶群 - 召唤出一群长着锋利翅膀的蝴蝶，能把挡路的每个生物都切得粉碎。
        // 分析: effect=summon + effect_str=mon_razor_butterflies + valid_targets=ground + CONJURATION_SPELL → BattleSummonMonster
        butterfly_swarm: null,
        // 林海卫士 - 召唤一位林间守护者，一个强大的远古森林之灵，来为你而战。守护者可以骑乘，它会对非自然的敌人宣泄怒火，但在城市中远不如在森林里强大。
        // 分析: effect=summon + effect_str=mon_keeper_of_the_glades_shaman + valid_targets=ground + CONJURATION_SPELL → BattleSummonMonster
        summon_keeper_of_the_glades: null,
        // 分析: effect=attack + valid_targets=ally + targeted_monster_ids + 内部法术(给召唤物添加效果) → 特殊: 内部辅助法术，暂不处理
        summon_keeper_of_the_glades_pet_effect: null,

        // === RADIATION_MAGE 辐射法师 ===
        // 短波术 - 烤熟附近的怪物（还包括你自己）。
        // 分析: effect=attack + 无effect_str + 正数伤害(20) + valid_targets=hostile,ground,self + 有aoe(3) → SelfAoeDamage (自身中心AOE)
        shortwave: null,
        // 伽马射线 - 在大范围内造成细胞损伤，施放速度快，但见效慢。
        // 分析: effect=attack + 无effect_str + 正数伤害(2) + DOT(5-30) + valid_targets=hostile,ally + 有aoe(6-10) + 无range → SelfAoeDamage
        gamma_burst: null,

        // === PERMAFROST_MAGE 永冻法师 ===
