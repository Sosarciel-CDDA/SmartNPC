        railgun: null,
        // 电子激光 - 通过使用高功率激光束电离空气分子，创建出一条从施法者手到目标的导电通道，然后沿着通道释放出50万伏的强大电荷。
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile,ground + range=6-26 + multiple_projectiles=4 → TargetDamage
        magnetismmage_electrolaser: null,
        // 电涌术 - 发出一道高频交变脉冲波。它无法伤害生物，但在眩晕和摧毁机器人方面效果卓越，尽管它并非电磁脉冲。
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile,ground + targeted_monster_species=ROBOT,CYBORG + range=10-55 + 有field_id → TargetDamage (特殊: 只对机器人/赛博格有效)
        robot_disabler_explosion: null,

