        // 分析: effect=spawn_item + effect_str=subzero_talons + valid_targets=none + CONJURATION_SPELL + duration=180s-20min → 特殊: 生成装备法术，暂不处理
        summon_subzero_talons: null,
        // 冰寒之心 - 骤然降低敌人体内的温度，使其血液流动减缓，甚至震碎其脏器。
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile + range=6-20 + 有extra_effects → TargetDamage
        cold_heart: null,
        // 恒霜术 - 凭借自己血液中的冰寒和魔法的力量，你召唤出一大块永不融化的魔法坚冰。
        // 分析: effect=ter_transform + effect_str=icelemental_crystal + valid_targets=ground + CONJURATION_SPELL → 特殊: 地形变换法术，暂不处理
        iceelemental_frostcrystal: null,

        // === GRAVITY_MAGE 重力法师 ===
        // 引力子极化 - 改变并增幅你所选定的一点所受的引力，甚至能穿透墙壁。此法术会吸入物品，并对其中心造成钝击伤害。
        // 分析: effect=area_pull + 无effect_str + 正数伤害(动态) + valid_targets广泛 + range=5-17 + 有aoe(4-9) → 特殊: 区域吸引法术，暂不处理
        gravitymage_graviton: null,
        // 重力飞跃 - 将你的体重降至最低，并驾驭一股魔力流从远处跃向敌人。
        // 分析: effect=dash + 无effect_str + 无伤害 + valid_targets=ground + CONVEYANCE_SPELL + range=4-21 → 特殊: 位移跳跃法术，暂不处理
        gravity_mage_leap: null,
        // 触知传动 - 当你接触一个物体时，操控它的引力会变得轻而易举。掌控你周身的引力来改变自身惯性，从而发动迅捷而沉猛的攻击。
        // 分析: effect=attack + effect_str=gravity_mage_melee + valid_targets=self + ENHANCEMENT_SPELL + duration=200s-7200s(2小时) → BattleSelfBuff (近战增益)
        gravity_mage_melee: null,

        // === GOLEMANCER 魔像师 ===
