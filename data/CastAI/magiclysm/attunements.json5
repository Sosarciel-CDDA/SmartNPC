        ice_clave: null,
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile,ground + 内部法术(ice_clave的额外效果) → 特殊: 内部法术，暂不处理
        ice_clave_blunt: null,
        // 凛冽狂风 - 一阵比大地上任何山顶的都冷的风，从你指间盘旋而出，破坏、推动着途径的一切。
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=hostile,ground + range=12-24 + aoe=3-6 + shape=line + 有push效果 → TargetDamage (线形AOE)
        frozen_winds: null,
        // 分析: effect=directed_push + 无effect_str + 正数伤害(3-5) + valid_targets=hostile,ground + 内部法术(frozen_winds的额外效果) → 特殊: 内部法术，暂不处理
        frozen_winds_push: null,

