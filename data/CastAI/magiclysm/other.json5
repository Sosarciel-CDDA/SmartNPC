{
    require_mod: "magiclysm",
    table: {
        //魔力结晶
        //将魔力凝聚成固体结晶型态。
        // 分析: effect=effect_on_condition + effect_str=eoc_crystal_spawn → 特殊: effect_on_condition暂不处理
        crystallize_mana: null,

        //魔力结晶（1）
        //魔力结晶生成器。如果你能看到这个，可能是调试时用的。
        // 分析: effect=spawn_item + effect_str=crystallized_mana + valid_targets=self → 特殊: 生成物品法术，暂不处理
        crystallize_mana_1: null,

        //魔力结晶（5）
        //魔力结晶生成器。如果你能看到这个，可能是调试时用的。
        // 分析: effect=spawn_item + effect_str=crystallized_mana + valid_targets=self → 特殊: 生成物品法术，暂不处理
        crystallize_mana_crystal_5: null,

        //魔力疲乏
        //魔力结晶的副作用。
        // 分析: effect=attack + effect_str=mana_fatigue + valid_targets=self + 内部法术 → 特殊: 内部法术，暂不处理
        mana_fatigue: null,

        //黑暗视觉
        //给你在黑暗中视物的能力。
        // 分析: effect=attack + effect_str=dark_sight + valid_targets=self + duration=1.6min-16.6min → AlawaySelfBuff (夜视效果)
        dark_sight: null,

        //炽能冲击
        //你经常想发射光波，就像小时候看过的动画片里那样，现在你可以了！
        // 分析: effect=attack + 无effect_str + 正数伤害(动态) + valid_targets=ally,hostile,ground + shape=line → TargetDamage (线形攻击)
        megablast: "TargetDamage",

        //魔法阅读灯
        //创造一盏神奇的魔法阅读灯。
        // 分析: effect=spawn_item + effect_str=magic_light + valid_targets=none → 特殊: 生成物品法术，暂不处理
        create_atomic_light: null,

        //致盲闪光
        //爆发耀眼的光芒以致盲敌人，等级越高伤害越高。
        // 分析: effect=attack + effect_str=blind + 正数伤害(1-2) + valid_targets=hostile,ground + range=4-16 + aoe=0-3 → TargetDebuff (致盲效果)
        blinding_flash: null,

        //空灵攫抓
        //无数鬼手破土而出，抓住并减速范围内的所有目标。
        //更高等级可以扩大影响范围并延长持续时间。
        //体型较大的目标受此法术的影响较小。
        // 分析: effect=effect_on_condition + effect_str=EOC_CLASSLESS_ETHEREAL_GRASP + valid_targets=hostile,ground → 特殊: effect_on_condition暂不处理
        ethereal_grasp: null,

        //朦胧术
        //一个魔法光环扭曲了你身体周围的光线，增加了你在一个回合中所能闪避攻击的次数。
        obfuscated_body: "BattleSelfBuff",

        //高级朦胧术
        //一个魔法光环扭曲了你身体周围的光线，增加了你在一个回合中所能闪避攻击的次数。
        obfuscated_body_plus: "BattleSelfBuff",

        //保护光环
        //把你的整个身体包裹在一个神奇的光环里，保护你免受环境伤害。
        // 分析: effect=spawn_item + effect_str=protect_env + valid_targets=self + duration=4min-1h → 特殊: 生成物品法术，暂不处理
        protection_aura: null,

        //强化保护光环
        //用一层魔法灵光包裹你的全身，保护你免受环境影响。
        //现在你对此法术已了如指掌，并开始着手设计属于你的版本。
        // 分析: effect=spawn_item + effect_str=protect_env + valid_targets=self + duration=1h-6h → 特殊: 生成物品法术，暂不处理
        protection_aura_plus: null,

        //自我传送
        //将使用者传送到一个已经开启的易位门。
        // 分析: effect=translocate + valid_targets=self + CONVEYANCE_SPELL → 特殊: 传送法术，暂不处理
        translocate_self: null,

        //防酸术
        //让施法者不受酸液侵蚀。
        // 分析: effect=attack + effect_str=effect_acid_res_aura + valid_targets=self + duration=4min-1h → AlawaySelfBuff (防酸效果)
        acid_resistance: null,

        //高等防酸术
        //保护使用者免受酸液伤害。
        //现在你对此法术已了如指掌，并开始着手设计属于你的版本，不再需要你持续集中精神。
        // 分析: effect=attack + effect_str=effect_acid_res_aura_greater + valid_targets=none + duration=30min → AlawaySelfBuff (防酸效果)
        acid_resistance_greater: null,

        //心灵防护
        //你的太阳穴上会出现两个闪闪发光的小点，保护你的心灵不受外界影响。
        // 分析: effect=spawn_item + effect_str=thought_shield_item + valid_targets=self + duration=4min-1h → 特殊: 生成物品法术，暂不处理
        thought_shield: null,

        //心灵套装
        //为什么只保护你的心智不受外界影响？
        //在身体各处设置更多防护也能防止被强行传送。
        // 分析: effect=spawn_item + effect_str=thought_shield_plus_item + valid_targets=self + duration=1h-6h → 特殊: 生成物品法术，暂不处理
        thought_shield_plus: null,

        //声波炸弹
        //酷炫的名字背后隐藏着一个常见的玩笑咒语，可以吓唬你的朋友并让狗呆住。
        //它在某些特殊情况下很有用。
        // 分析: effect=noise + 正数伤害(12-120) + valid_targets=self,ally,hostile,ground + range=5-55 → TargetDamage (声波攻击)
        sound_bomb: null,

        //知晓时间
        //这个法术可能是科技淘汰魔法的最伟大范例，它能让你准确知道现在的时间。
        // 分析: effect=attack + effect_str=effect_classless_watch + valid_targets=self + duration=2h-24h → AlawaySelfBuff (知晓时间)
        classless_watch_spell: null,

        //梳洗术
        //这无疑是大灾变前世界上最普及的法术。
        //梳洗术能清洁你的牙齿，清新你的口气，去除衣物上的污渍与汗水，
        //还能为你的皮肤去角质，让你的秀发重现蓬松。
        // 分析: effect=effect_on_condition + effect_str=EOC_CLASSLESS_CLEAN_CLOTHING_AND_SELF + valid_targets=self → 特殊: effect_on_condition暂不处理
        classless_clean_clothing_and_self: null,

        //安睡术
        //此法术深受劳累过度的法师和浅尝辄止的魔法爱好者们喜爱，
        //无论你有多疲惫，它都能让你更容易入睡。
        // 分析: effect=attack + effect_str=effect_classless_easy_sleep + valid_targets=self + duration=1h → AlawaySelfBuff (助眠效果)
        classless_easy_sleep_spell: null,

        //驱散魔法
        //移除目标身上的魔法效果。
        //当面对强大的魔法或调谐提供的独特加成时，它就会失效。
        // 分析: effect=attack + effect_str=effect_dispel_magic + valid_targets=self,ally,hostile + range=3-20 → TargetDebuff (驱散魔法)
        classless_dispel_magic: null,

        //法术裂解
        //反魔法的终极法术。即使是调谐相关、法力高强的附魔效果，法术裂解也能移除。
        //（译注：移除所有法术效果及法术召唤物品，不会影响永久魔法物品）
        // 分析: effect=attack + effect_str=effect_disjunction + valid_targets=self,ally,hostile + range=3-20 → TargetDebuff (强力驱散)
        classless_disjunction: null,

        //魔力提取
        //将魔力结晶还原为原始的魔力并将其吸收，恢复你的部分魔力。
